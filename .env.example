# ============================================================
#  Coach AI — scegli UNO dei due backend
# ============================================================
# Senza nessuna configurazione l'app usa l'analisi euristica locale:
# funziona, e' gratis, ma non "giudica" — applica regole fisse.

# ---- Opzione A: Anthropic (qualita' migliore, a pagamento) ----
# Chiave da console.anthropic.com -> Settings -> API keys
# ANTHROPIC_API_KEY=sk-ant-api03-...
#
# Modello. Default claude-opus-5. Costo indicativo per giro analizzato:
#   claude-opus-5     ~7 cent
#   claude-sonnet-5   ~3 cent
#   claude-haiku-4-5  ~1,5 cent  (thinking ed effort si disattivano da soli)
# ANTHROPIC_MODEL=claude-opus-5
#
# Profondita' di ragionamento: low | medium | high | xhigh | max (default high).
# Abbassarla riduce il costo. Ignorata su haiku.
# ANTHROPIC_EFFORT=high

# ---- Opzione B: qualunque provider "OpenAI-compatibile" ----
# Ha la precedenza su Anthropic se COACH_BASE_URL e' impostato.
#
# I nomi dei modelli cambiano e vengono ritirati: non fidarti di questa guida,
# chiedili al provider dopo aver impostato base url e chiave.
#     python main.py --list-models
# stampa le righe COACH_MODEL= gia' pronte da incollare qui sotto.
#
# Google AI Studio (aistudio.google.com):
#   COACH_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#
# OpenRouter (openrouter.ai):
#   COACH_BASE_URL=https://openrouter.ai/api/v1
#
# Groq (console.groq.com):
#   COACH_BASE_URL=https://api.groq.com/openai/v1
#
# Modello locale con Ollama, sullo stesso PC del gioco.
#
# La chiave e' NON usare la GPU: quella serve al gioco. Il coach gira una
# volta a fine giro, quindi ha un minuto buono di tempo — su CPU e' lento ma
# invisibile, e la scheda video resta libera.
#   OLLAMA_NUM_GPU=0            (variabile di Ollama, non di questa app)
#   COACH_BASE_URL=http://localhost:11434/v1
#   COACH_API_KEY=ollama
#   COACH_MODEL=...             vedi: main.py --list-models
#
# ATTENZIONE — il gioco usa la CPU quanto il modello.
# Un'inferenza che satura tutti i core toglie fisica e audio al gioco: si
# stuttera, e nei casi peggiori il gioco chiude. Due difese, entrambe utili:
#
#   1. Nel Modelfile, lascia core liberi al gioco (meta' dei core e' un buon
#      punto di partenza; su un 8 core:  PARAMETER num_thread 4)
#   2. COACH_WHEN qui sotto, che di default con un modello locale rimanda
#      l'analisi a quando sei fermo o ai box
#
# Quando far girare l'analisi:
#   lap     a ogni giro chiuso — per un modello remoto, che non consuma
#           niente sulla macchina del gioco
#   pit     solo da fermi o ai box — default con un modello in locale
#   manual  solo col pulsante Rianalizza
# COACH_WHEN=pit
#
# Intervallo minimo fra due analisi, in secondi. Utile sui circuiti corti,
# dove un giro dura meno dell'analisi. 0 = nessun limite.
# COACH_MIN_INTERVAL_S=0

# Prima di fidarti, misura sulla TUA macchina:
#   main.py --bench-coach
# Dice quanto ci mette davvero e se sta nel budget di un giro.
# Un modello da 3-4B sta di solito dentro; da 7-8B e' al limite.
#
# COACH_BASE_URL=
# COACH_API_KEY=
# COACH_MODEL=
# COACH_TIMEOUT=90
#
# Tetto sui token prodotti. Un modello piccolo senza tetto puo' dilungarsi
# fino al timeout: e' la causa piu' comune di un'analisi che non torna.
# Un report utile sta in 400-600 token; 1400 lascia margine.
# COACH_MAX_TOKENS=1400

# ============================================================
#  Telemetria
# ============================================================
# auto: live se il gioco e' aperto, altrimenti demo. Oppure: demo | live
# ACEVO_MODE=auto
