# Coaching AI: senza chiave l'app usa l'analisi euristica locale (funziona lo stesso).
# ANTHROPIC_API_KEY=sk-ant-...

# Modello. Default: claude-opus-5 (migliore, ~5-10 cent per giro analizzato).
# Alternative piu' economiche:
#   claude-sonnet-5    ~3 cent/giro
#   claude-haiku-4-5   ~1.5 cent/giro (thinking ed effort vengono disattivati da soli)
# ANTHROPIC_MODEL=claude-opus-5

# Profondita' di ragionamento: low | medium | high | xhigh | max. Default high.
# Abbassarlo riduce il costo; ignorato su haiku.
# ANTHROPIC_EFFORT=high

# auto: live se il gioco e' aperto, altrimenti demo. Oppure: demo | live
# ACEVO_MODE=auto
